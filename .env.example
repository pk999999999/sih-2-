JOCKY_ENV=development
DATABASE_URL=postgresql+psycopg://jocky:jocky@postgres:5432/jocky
JWT_SECRET=change-me-in-production-use-32-plus-characters
AGENT_API_KEY=dev-agent-key
DEMO_EMAIL=analyst@jocky.local
DEMO_PASSWORD=jocky-demo
STORAGE_BACKEND=local
JWT_ISSUER=jocky
ACCESS_TOKEN_MINUTES=60
S3_ENDPOINT=objectstore:8333
S3_ACCESS_KEY=jocky
S3_SECRET_KEY=jocky-secret
S3_BUCKET=evidence
VITE_API_URL=http://localhost:8000
BLOCKCHAIN_MOCK=true
BLOCKCHAIN_MOCK_DB=./mock-chain.db
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# Set these from `npm --prefix blockchain run deploy` for real local EVM mode.
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_ACCOUNT=
BLOCKCHAIN_ABI_PATH=../blockchain/deployment.json
